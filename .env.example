# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env จริงห้าม push ขึ้น GitHub — .gitignore กันไว้แล้ว)
# ถ้าไม่สร้าง .env ระบบจะใช้ค่า default ใน docker-compose.yml ให้อัตโนมัติ
# ในไฟล์นี้มีเฉพาะตัวแปรที่โค้ด/compose อ่านจริง ๆ ไม่มีตัวแปรลอย

# ---- PostgreSQL (คอนเทนเนอร์ db ของ docker-compose) ----
# 3 ตัวนี้ docker-compose ส่งให้ image postgres:16 ใช้สร้าง user/ฐานข้อมูลตอนบูตครั้งแรก
# ถ้าแก้แล้ว ต้องแก้ DATABASE_URL ให้ตรงกันด้วย และลบ volume db_data ก่อน (ค่าเดิมฝังอยู่ในนั้น)
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# ---- FastAPI (คอนเทนเนอร์ web) ----
# backend/app/database.py อ่านตัวนี้ตัวเดียวเพื่อตัดสินใจว่าจะต่อฐานข้อมูลไหน
# - ตั้งค่า  → PostgreSQL (ในเครือข่ายของ Compose ใช้ชื่อ service "db" เป็น host ได้เลย)
# - ไม่ตั้ง  → fallback เป็น SQLite ไฟล์ backend/astra.db (สะดวกตอน dev แต่ห้ามใช้บน production)
# รองรับทั้ง postgres:// และ postgresql:// (โค้ดแปลงเป็น driver psycopg ให้เอง)
# บน Render ไม่ต้องกรอกเอง — render.yaml ดึงจากฐานข้อมูลที่สร้างให้อัตโนมัติ
DATABASE_URL=postgresql://appuser:apppassword@db:5432/appdb

# พอร์ตที่ uvicorn bind (CMD ใน backend/Dockerfile อ่านเป็น ${PORT:-8000})
# ในเครื่องไม่ต้องตั้ง — Render/Railway จะ inject ค่านี้ให้เองตอนรัน ห้าม hardcode ทับ
# PORT=8000

# ใช้เฉพาะตอนรันเทสต์ (backend/tests/conftest.py) ถ้าอยากทดสอบกับ PostgreSQL จริง
# ไม่ตั้ง = เทสต์ใช้ SQLite ชั่วคราวในโฟลเดอร์ temp
# TEST_DATABASE_URL=postgresql://appuser:apppassword@localhost:5433/appdb
