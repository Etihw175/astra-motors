# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ไฟล์ .env จริงห้าม push ขึ้น GitHub)
# ถ้าไม่สร้าง .env ระบบจะใช้ค่า default ใน docker-compose.yml ให้อัตโนมัติ

# ---- PostgreSQL (คอนเทนเนอร์ db) ----
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppassword
POSTGRES_DB=appdb

# ---- FastAPI (คอนเทนเนอร์ web) ----
# ในเครือข่ายของ Docker Compose ใช้ชื่อ service "db" เป็น host ได้เลย
DATABASE_URL=postgresql://appuser:apppassword@db:5432/appdb
